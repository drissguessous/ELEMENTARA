{
  "name": "elementara",
  "version": "0.1.0",
  "description": "Elementara – 3D action game (fights & parkour) for kids 8-16. Mobile (Android/iOS) and web.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && npx cap sync",
    "android": "npm run cap:sync && npx cap open android",
    "ios": "npm run cap:sync && npx cap open ios"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/earcut": "^3.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@babylonjs/core": "^9.36.0",
    "@babylonjs/gui": "^9.36.0",
    "@babylonjs/loaders": "^9.36.0",
    "@babylonjs/materials": "^9.36.0",
    "@babylonjs/procedural-textures": "^9.36.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/cinzel": "^5.3.0",
    "earcut": "^3.2.4"
  },
  "private": true,
  "type": "module"
}
